<!doctype html>
<html lang="ja">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Expense</title>
  <link rel="stylesheet" href="/static/style.css?v={{ range(100000, 999999) | random }}" />
  <link rel="manifest" href="/static/manifest.json" />
  <meta name="theme-color" content="#111827">
  <script src="/static/preload.js?v={{ range(100000, 999999) | random }}"></script>
</head>

<body data-reload-icon="{{ icons.get('reload', '🔄') }}">
  <button id="install-btn" class="btn install" style="display: none;"> {{ icons.get("pwa_install", "📲") }}
    インストール</button>
  <button id="hamburger-menu-btn" class="small-btn"> ☰ </button>
  <div id="menu-container">
    <form method="get" action="/"><button type="submit" id="home-btn" class="small-btn"> {{ icons.get("home", "🏠") }}
        家計簿　　　　 </button></form>
    <form method="get" action="/asset_management"><button type="submit" id="asset-management-btn" class="small-btn"> {{
        icons.get("asset_management", "📈") }} 資産管理　　　 </button></form>
    <form method="get" action="/simulator"><button type="submit" id="simulator-btn" class="small-btn"> {{
        icons.get("simulator", "🎯") }} シミュレーター </button></form>
    <button id="theme-toggle" class="small-btn"> {% if theme == "dark" %} {{ icons.get("light_theme", "☀️") }} {% else
      %} {{ icons.get("dark_theme", "🌙") }} {% endif %} テーマ　　　　 </button>
  </div>
  <div class="container">
    <h1> {{ icons.get("title", "") }} Asset Management </h1>

    <div class="card">
      <div class="asset-chart-header">
        <h3 class="collapsible-trigger" data-key="asset-report">
          <span> {{ icons.get("asset_summary", "📊") }} 資産サマリ </span>
          <span class="collapsible-toggle"></span>
        </h3>
      </div>
      <div id="asset-summary-chart-controls" class="chart-controls"></div>
      <div id="asset-summary-chart-container">
        {% include 'asset_summary_content.j2' %}
      </div>
      <br>
    </div>

    <div class="card">
      <h3 class="collapsible-trigger" data-key="asset-chart">
        <span> {{ icons.get("asset_chart", "📈") }} 資産チャート </span>
        <span class="collapsible-toggle"></span>
      </h3>
      <div id="asset-chart-container" class="collapsible-content">
        {{ plotlyjs | safe }}
        <div id="asset-pie-chart-controls" class="chart-controls"></div>
        <div id="asset-pie-chart-container" class="loading">
          <div class="spinner"></div>
        </div>
        <hr>
        <div id="asset-heatmap-chart-controls" class="chart-controls"></div>
        <div id="asset-heatmap-chart-container" class="loading">
          <div class="spinner"></div>
        </div>
        <hr>
        <div class="asset-chart-header">
          <div class="asset-chart-title">
            銘柄別チャート
          </div>
          <div id="asset-tradingview-chart-controls" class="chart-controls">
            <select id="symbol-select" class="symbol-selector">
              {% for s in asset_tickers %}
              <option value="{{ s }}">{{ s }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div id="asset-tradingview-chart-container"></div>
        <hr>
        <div id="asset-waterfall-chart-controls" class="chart-controls"></div>
        <div id="asset-waterfall-chart-container" class="loading">
          <div class="spinner"></div>
        </div>
        <hr>
        <div id="asset-monthly-history-chart-controls" class="chart-controls simulation-controls">
          <div class="simulation-input-group">
            <label for="sim-yield">年利 (%)</label>
            <input type="number" id="sim-yield" placeholder="5.0" step="0.1" min="-100" max="1000">
          </div>
          <div class="simulation-input-group">
            <label for="sim-investment">月次積立 (¥)</label>
            <input type="number" id="sim-investment" placeholder="300000" step="10000" min="0">
          </div>
          <div class="simulation-input-group">
            <label for="sim-years">期間 (年)</label>
            <input type="number" id="sim-years" placeholder="5" step="0.1" min="0" max="100">
          </div>
        </div>
        <div id="asset-monthly-history-chart-container" class="loading">
          <div class="spinner"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <h3 class="collapsible-trigger" data-key="asset-allocation">
        <span>{{ icons.get("asset_allocation", "🎯") }} アセットアロケーション </span>
        <span class="collapsible-toggle"></span>
      </h3>
      <div id="asset-allocation-container" class="collapsible-content">
        {% if asset_allocation %}
        <p>目標比率からの許容差: {{ "{:.2f}".format(allocation_tolerance_percent) }}%</p>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>銘柄</th>
                <th>現在比率(%)</th>
                <th>目標比率(%)</th>
                <th>目標評価額(¥)</th>
                <th>売買額(¥)</th>
                <th>判定</th>
              </tr>
            </thead>
            <tbody>
              {% for allocation in asset_allocation %}
              <tr data-tickers='{{ allocation.tickers | tojson }}'>
                <td>{{ allocation.ticker }}</td>
                <td>{{ "{:.2f}".format(allocation.current_weight) }}%</td>
                <td>{{ "{:.2f}".format(allocation.target_weight) }}%</td>
                <td>¥ {{ "{:,.0f}".format(allocation.target_value) }}</td>
                <td>
                  {% if allocation.action == "買い" %}+{% elif allocation.action == "売り" %}-{% endif %}¥ {{ "{:,.0f}".format(allocation.trade_value|abs) }}
                </td>
                <td>{{ allocation.action }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <p>config.json の asset_management.allocation.target_weights に目標比率または目標金額を設定してください。</p>
        {% endif %}
      </div>
    </div>

    <div id="allocation-tickers-overlay" class="overlay" style="display: none;">
      <div id="allocation-tickers-dialog" class="confirm allocation-tickers-dialog">
        <h3>グループ内の銘柄</h3>
        <button id="allocation-tickers-close-btn" type="button" class="btn-close">✕</button>
        <ul id="allocation-tickers-list"></ul>
      </div>
    </div>

    <div class="card">
      <h3 class="collapsible-trigger" data-key="asset-record">
        <span> {{ icons.get("asset_list", "📝") }} 資産一覧 </span>
        <span class="collapsible-toggle"></span>
      </h3>
      <div id="asset-record-container" class="collapsible-content">
        <div class="search-wrapper">
          <input type="text" id="search-input" placeholder="{{ icons.get('search', '🔍') }} 資産をフィルタリング" />
          <button id="clear-search" type="button">✕</button>
        </div>
        <div class="table-container">
          <table>
            <colgroup>
              <col>
              <col>
              <col>
              <col>
              <col>
              <col>
              <col>
              <col>
              <col>
              <col>
            </colgroup>
            <thead>
              <tr>
                <th>銘柄</th>
                <th>保有数</th>
                <th>取得単価(¥)</th>
                <th>現在値($)</th>
                <th>現在値(¥)</th>
                <th>投資額(¥)</th>
                <th>評価額(¥)</th>
                <th>含み益(¥)</th>
                <th>保有比率(%)</th>
                <th>評価損益率(%)</th>
              </tr>
            </thead>
            <tbody>
              {% for item in asset_items %}
              <tr>
                <td>{{ item.ticker }}</td>
                <td>{{ item.num }}</td>
                <td>¥ {{ "{:,.0f}".format(item.acquisition) }}</td>
                <td>$ {{ "{:,}".format(item.price_dollar) }}</td>
                <td>¥ {{ "{:,.0f}".format(item.price) }}</td>
                <td>¥ {{ "{:,.0f}".format(item.invest_amount) }}</td>
                <td>¥ {{ "{:,.0f}".format(item.valuation) }}</td>
                <td>¥ {{ "{:,.0f}".format(item.profit) }}</td>
                <td>{{ "{:.2f}".format(item.weight) }}%</td>
                <td>{{ "{:.2f}".format(item.roi) }}%</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="link-container">
          <br>
          <a href="{{ gspread_url }}" class="link-text">
            {{ icons.get("link", "🔗") }} スプレッドシートを開く </a>
        </div>
      </div>
    </div>

  </div>
  <div id="loader" class="overlay" style="display: none;">
    <div class="spinner"></div>
  </div>
</body>
<script src="https://s3.tradingview.com/tv.js"></script>
<script type="module" src="/static/js/main.js"></script>

</html>
